RUNQUILL_OWNER=your-github-login
# Set organization when RUNQUILL_OWNER is a GitHub organization.
# RUNQUILL_OWNER_TYPE=user
# Optional organization runner group ID. Without it, runners register on each repository.
# RUNQUILL_RUNNER_GROUP_ID=123
RUNQUILL_APP_ID=123456
# Set selected if you choose Only select repositories when installing the App.
# RUNQUILL_REPOSITORY_SCOPE=all
# Leave blank for polling-only operation.
RUNQUILL_WEBHOOK_SECRET=
RUNQUILL_POLL_INTERVAL=30s
RUNQUILL_KEY_FILE=./github-app.pem
RUNQUILL_MAX_RUNNERS=2
# One manager schedules across all listed Docker engines.
# RUNQUILL_DOCKER_HOSTS=local,ssh://builder@worker.example.com
# RUNQUILL_DOCKER_HOST_LIMITS=local=2,ssh://builder@worker.example.com=1
# RUNQUILL_SSH_DIR=./runquill-ssh
# To register an agent:// host from the panel, set the manager origin that proxies /worker/v1/*.
# RUNQUILL_WORKER_ENROLLMENT_URL=https://workers.example.com
# RUNQUILL_WORKER_PROXY_IP=172.18.0.1
# RUNQUILL_WORKER_POOLS='{"build":{"hosts":["ssh://builder@worker.example.com"],"repositories":["you/project"],"cpus":4,"memory_mib":8192}}'
# Set both image names to the same release tag when deploying published images.
# RUNQUILL_MANAGER_IMAGE=ghcr.io/yakisoba0728/runquill:v0.3.3
# RUNQUILL_RUNNER_IMAGE=ghcr.io/yakisoba0728/runquill-runner:v0.3.3
# Optional manager settings. Compose passes these only through an overlay; see "Add manager settings" in README.md.
# Per-pool cap on one repository's runners; 0 is unlimited.
# RUNQUILL_MAX_PER_REPOSITORY=0
# RUNQUILL_SCHEDULER_WORKERS=4
# Jobs from public repositories run only when this is true; see docs/workflows.md for the fork run checks and required approval policy.
# RUNQUILL_ALLOW_PUBLIC_REPOSITORIES=false
# RUNQUILL_LOG_FORMAT=json
# RUNQUILL_LOG_LEVEL=info
# Treat the notification URL as a secret.
# RUNQUILL_NOTIFY_URL=https://hooks.slack.com/services/...
# RUNQUILL_NOTIFY_FORMAT=slack
# RUNQUILL_NOTIFY_COOLDOWN=30m
# RUNQUILL_NOTIFY_STALL_AFTER=10m
# Container CLI for the local and ssh:// hosts: docker or podman. The published manager image has only the Docker CLI.
# RUNQUILL_CONTAINER_ENGINE=docker
# Runner image pulls on the local and ssh:// hosts: missing pulls absent images, always also refreshes them, never leaves them to you.
# RUNQUILL_IMAGE_PULL=missing
# RUNQUILL_IMAGE_PULL_INTERVAL=6h
# Runner OS names jobs select with os__NAME__ in runs-on; see docs/runner-images.md. The published manager image knows only ubuntu-latest and ubuntu24.04 without it.
# RUNQUILL_RUNNER_IMAGES='{"ubuntu22.04":"ghcr.io/yakisoba0728/runquill-runner:v0.3.3-ubuntu22.04","debian12":"ghcr.io/yakisoba0728/runquill-runner:v0.3.3-debian12"}'
# Removal of runner images Runquill pulled and cache volumes unused for this long; off disables it.
# RUNQUILL_CLEANUP_AFTER=30d
# RUNQUILL_CLEANUP_IMAGES_AFTER=30d
# RUNQUILL_CLEANUP_CACHE_AFTER=30d
# RUNQUILL_CLEANUP_INTERVAL=6h
# Elastic runner limits on the local Docker host; see docs/elastic-limits.md.
# RUNQUILL_ELASTIC=off
# RUNQUILL_ELASTIC_INTERVAL=10s
# RUNQUILL_ELASTIC_COOLDOWN=30s
# RUNQUILL_ELASTIC_HOST_RESERVE_CPUS=1
# RUNQUILL_ELASTIC_HOST_RESERVE_MEMORY_MIB=512
# RUNQUILL_ELASTIC_MEMORY_TRIGGER=0.9
# RUNQUILL_ELASTIC_MAX_MULTIPLE=2
# RUNQUILL_JOB_RESOURCES=on
# Scheduled queue backups; see docs/backups.md. Treat the passphrase and S3 secret as secrets.
# RUNQUILL_BACKUP_INTERVAL=24h
# RUNQUILL_BACKUP_DIR=/backups
# RUNQUILL_BACKUP_KEEP=7
# Set the passphrase or its file, not both; at least 12 characters.
# RUNQUILL_BACKUP_PASSPHRASE=
# RUNQUILL_BACKUP_PASSPHRASE_FILE=/run/secrets/backup-passphrase
# RUNQUILL_BACKUP_S3_ENDPOINT=https://s3.example.com
# RUNQUILL_BACKUP_S3_BUCKET=runquill-backups
# RUNQUILL_BACKUP_S3_REGION=us-east-1
# RUNQUILL_BACKUP_S3_PREFIX=runquill/
# RUNQUILL_BACKUP_S3_ACCESS_KEY_ID=
# RUNQUILL_BACKUP_S3_SECRET_ACCESS_KEY=
# RUNQUILL_BACKUP_S3_SECRET_ACCESS_KEY_FILE=
# RUNQUILL_BACKUP_S3_PATH_STYLE=false
# RUNQUILL_BACKUP_S3_KEEP=7
# Uploads of unsealed backups are refused unless this is true.
# RUNQUILL_BACKUP_S3_ALLOW_PLAINTEXT=false
