RUNQUILL_OWNER=your-github-login
# Set organization when RUNQUILL_OWNER is a GitHub organization.
# RUNQUILL_OWNER_TYPE=user
# Optional organization runner group ID. Without it, runners register on each repository.
# RUNQUILL_RUNNER_GROUP_ID=123
RUNQUILL_APP_ID=123456
# Set selected if you choose Only select repositories when installing the App.
# RUNQUILL_REPOSITORY_SCOPE=all
# Leave blank for polling-only operation.
RUNQUILL_WEBHOOK_SECRET=
RUNQUILL_POLL_INTERVAL=30s
RUNQUILL_KEY_FILE=./github-app.pem
RUNQUILL_MAX_RUNNERS=2
# One manager schedules across all listed Docker engines.
# RUNQUILL_DOCKER_HOSTS=local,ssh://builder@worker.example.com
# RUNQUILL_DOCKER_HOST_LIMITS=local=2,ssh://builder@worker.example.com=1
# RUNQUILL_SSH_DIR=./runquill-ssh
# RUNQUILL_WORKER_POOLS='{"build":{"hosts":["ssh://builder@worker.example.com"],"repositories":["you/project"],"cpus":4,"memory_mib":8192}}'
# Set both image names to the same release tag when deploying published images.
# RUNQUILL_MANAGER_IMAGE=ghcr.io/yakisoba0728/runquill:v0.2.0
# RUNQUILL_RUNNER_IMAGE=ghcr.io/yakisoba0728/runquill-runner:v0.2.0
